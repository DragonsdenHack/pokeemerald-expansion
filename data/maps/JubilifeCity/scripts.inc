Jubileo_Cuarto_NPC::
lock     
faceplayer     
msgbox Jubileo_Cuarto_NPC_Texto_1, MSGBOX_NPC
release     
end

Jubileo_Cuarto_NPC_Texto_1:
.string "¡Hola! Deja que te haga una pregunta:\n"
.string "¿has ido ya a los estudios de televisión?\p"
.string "Si no lo has hecho, creo que deberías.\n"
.string "Te gustará, ya verás.\p"
.string "Y si has estado allí antes, puedes\n"
.string "volver, ¡repetir no hace daño a nadie!\p"
.string "Después de todo, ¡podrías convertirte\n"
.string "en una estrella! ¡O soñar con serlo!$"


