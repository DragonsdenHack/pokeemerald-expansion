Corazon_Segundo_NPC::
lock     
faceplayer     
msgbox Corazon_Segundo_NPC_Texto_1, MSGBOX_NPC
release     
end

Corazon_Segundo_NPC_Texto_1:
.string "Tengo un amigo profesor que me dijo\n"
.string "una cosa muy interesante.\p"
.string "Si dejas a dos POKÉMON en la GUARDERÍA,\n"
.string "a veces se encuentran huevos.\p"
.string "O, al menos, cosas que parecen huevos.\p"
.string "Me pregunto qué será de mi amigo, el\n"
.string "PROFESOR ELM…\p"
.string "Siempre fue muy callado. Nunca llamó\n"
.string "demasiado la atención.$"


